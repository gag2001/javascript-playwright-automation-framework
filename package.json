{
  "name": "javascript-playwright-automation-framework",
  "version": "1.0.0",
  "description": "UI and API test automation framework built with JavaScript and Playwright",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gag2001/javascript-playwright-automation-framework.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gag2001/javascript-playwright-automation-framework/issues"
  },
  "homepage": "https://github.com/gag2001/javascript-playwright-automation-framework#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "private": true
}
